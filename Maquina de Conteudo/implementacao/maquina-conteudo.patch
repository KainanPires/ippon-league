+        console.log(`        parâmetros: ${JSON.stringify(g.parametros).slice(0, 300)}`);
+        for (const r of g.referencias) console.log(`        referência: ${r.caminho} (${r.sha256.slice(0, 12)}…)${r.url ? " ← " + r.url : ""}`);
